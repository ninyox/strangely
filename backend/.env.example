# Copy this file to .env for local development. Every value below has a safe
# default in config/env.go, so the backend runs with no .env at all; these are
# the settings that matter once you deploy.
#
# No real credential belongs in this file. Nothing here is committed.

# development | production. Production switches cookies to Secure and logs JSON.
ENVIRONMENT=development

# Where the browser app is served from. This is the allowlist for CORS *and*
# for the signaling WebSocket Origin check. Comma separate several origins.
# Wildcards are refused on purpose: requests carry credentials.
ALLOWED_ORIGINS=http://localhost:5173

# HTTP listen address.
LISTEN_ADDR=:8080

# Session cookie. Keep COOKIE_SECURE=false only for plain-HTTP local work.
COOKIE_NAME=strg_session
COOKIE_SECURE=false
# COOKIE_DOMAIN=.example.com

# Timers. A bare number is read as seconds ("5"), or use Go durations ("2h").
SESSION_TTL=2h
QUEUE_TTL=2m
MATCH_IDLE_TTL=20s
MAX_MATCH_DURATION=1h
# The server-enforced Skip lock. Clients cannot shorten or bypass it.
SKIP_LOCK_SECONDS=5

# STUN is enough on many home networks. A STUN server alone does not guarantee
# connectivity across every NAT or corporate firewall; add TURN for production.
STUN_URLS=stun:stun.l.google.com:19302

# TURN, preferred form: a shared secret, so the server mints short-lived
# credentials per request and no static credential ever reaches the browser.
# TURN_URL=turn:turn.example.com:3478?transport=udp
# TURN_SHARED_SECRET=replace-with-a-long-random-secret
# TURN_CREDENTIAL_TTL=1h

# TURN, fallback form: a static username/credential pair. Only for a TURN
# server that cannot do time-limited credentials, and never in a public bundle.
# TURN_USERNAME=strangerly
# TURN_CREDENTIAL=replace-me

# Request budgets, per client.
RATE_LIMIT_SESSION_PER_MINUTE=20
RATE_LIMIT_JOIN_PER_MINUTE=60
RATE_LIMIT_SIGNAL_PER_SECOND=60
RATE_LIMIT_REPORT_PER_10MIN=5

# debug | info | warn | error
LOG_LEVEL=info

# Leave empty when the API is exposed directly: gin then reads the socket peer
# address instead of a spoofable X-Forwarded-For header. Set it to your proxy
# addresses (comma separated) when running behind one.
# TRUSTED_PROXIES=127.0.0.1
# cline --id 1792922098587_ifldk