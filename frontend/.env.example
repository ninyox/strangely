# Copy this file to .env.local for local development (Vite loads .env.local
# automatically and it is git-ignored).
#
# There is exactly one setting: the API base URL. Everything else is derived
# from it — the signaling WebSocket URL (http becomes ws, https becomes wss)
# and the Content Security Policy connect-src that server.mjs applies when it
# serves the production build.
# VITE_API_BASE_URL=http://localhost:8080
VITE_API_BASE_URL=https://serve.subll.org
# Port for the production static server (`bun run start`). Defaults to 3000.
# PORT=3000
